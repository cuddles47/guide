# Copy this file to /etc/postgresql/backup.env and chmod 600 it.
# Use a dedicated backup role with REPLICATION and CONNECT privileges.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=backup
PGPASSWORD=change-me

# Directory owned by the PostgreSQL service account.
BACKUP_ROOT=/var/backups/postgresql/cluster_1
BACKUP_RETENTION_DAYS=14